{
  "name": "vexy-stax-js",
  "version": "3.1.6",
  "description": "Browser renderer for the vexy-stax shared scene format: 3D glass plates in two views, with morphable opacity. Ships as ESM, Web Component, and a classic-script global.",
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "schema",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "VEXY_BUILD=element vite build && VEXY_BUILD=global vite build",
    "preview": "vite preview",
    "test:unit": "node --test",
    "test": "npm run test:unit && playwright test",
    "build:docs": "node scripts/build-docs.mjs"
  },
  "keywords": [
    "threejs",
    "3d",
    "image-stack",
    "web-component",
    "scene",
    "vexy-stax"
  ],
  "author": "Adam Twardoch <adam+npm@twardoch.com> (https://twardoch.github.io/)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vexyart/vexy-stax-js.git"
  },
  "homepage": "https://vexyart.github.io/vexy-stax-js/",
  "bugs": {
    "url": "https://github.com/vexyart/vexy-stax-js/issues"
  },
  "sideEffects": [
    "./src/element.js",
    "./src/global.js"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "gsap": "^3.13.0",
    "mp4-muxer": "^5.2.2",
    "three": "^0.181.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "vite": "^7.1.12"
  }
}
